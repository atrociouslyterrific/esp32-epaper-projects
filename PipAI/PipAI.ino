// ================================================================ sensors

bool readSHTC3(float &tempC, float &humidity) {
  auto cmd = [](uint16_t c) {
    Wire.beginTransmission(SHTC3_ADDR);
    Wire.write(c >> 8);
    Wire.write(c & 0xFF);
    return Wire.endTransmission() == 0;
  };
  if (!cmd(0x3517)) return false;  // wake
  delay(1);
  if (!cmd(0x7866)) return false;  // measure, T first
  delay(20);
  if (Wire.requestFrom(SHTC3_ADDR, (uint8_t)6) != 6) return false;
  uint16_t rawT = (Wire.read() << 8) | Wire.read(); Wire.read();
  uint16_t rawH = (Wire.read() << 8) | Wire.read(); Wire.read();
  cmd(0xB098);  // sleep
  tempC = -45.0f + 175.0f * rawT / 65536.0f;
  humidity = 100.0f * rawH / 65536.0f;
  return true;
}

uint8_t bcd2dec(uint8_t v) { return (v >> 4) * 10 + (v & 0x0F); }
uint8_t dec2bcd(uint8_t v) { return ((v / 10) << 4) | (v % 10); }

// Read hour/minute from the PCF85063 clock chip. Returns false if never set.
bool readRtc(int &hour, int &minute) {
  Wire.beginTransmission(RTC_ADDR);
  Wire.write(0x04);
  if (Wire.endTransmission(false) != 0) return false;
  if (Wire.requestFrom(RTC_ADDR, (uint8_t)7) != 7) return false;
  uint8_t sec = Wire.read(), min = Wire.read(), hr = Wire.read();
  Wire.read(); Wire.read(); Wire.read();
  uint8_t yr = Wire.read();
  if (sec & 0x80) return false;          // oscillator stopped: time not valid
  if (bcd2dec(yr) < 25) return false;    // never set
  minute = bcd2dec(min & 0x7F);
  hour = bcd2dec(hr & 0x3F);
  return true;
}

void writeRtc(int year, int month, int day, int weekday, int hour, int minute, int second) {
  Wire.beginTransmission(RTC_ADDR);
  Wire.write(0x04);
  Wire.write(dec2bcd(second));
  Wire.write(dec2bcd(minute));
  Wire.write(dec2bcd(hour));
  Wire.write(dec2bcd(day));
  Wire.write(weekday);
  Wire.write(dec2bcd(month));
  Wire.write(dec2bcd(year % 100));
  Wire.endTransmission();
}

void readSenses() {
  float t, h;
  haveSensor = readSHTC3(t, h);
  senses.tempC = haveSensor ? t : 21.0f;
  senses.humidity = haveSensor ? h : 45.0f;

  int hr = 12, mn = 0;
  clockSet = readRtc(hr, mn);
  senses.hour = hr + mn / 60.0f;

  // Battery: no battery (USB only) reads as nonsense, so treat that as "plugged in, full".
  float v = analogReadMilliVolts(BAT_ADC) * 2 / 1000.0f;
  if (v > 4.3f || v < 2.8f) {
    senses.battery = 1.0f;
    senses.charging = 1;
  } else {
    senses.battery = pip_clamp01((v - 3.3f) / (4.15f - 3.3f));
    senses.charging = 0;
  }
  senses.sound = 0.0f;   // microphone hearing comes in a later version
  senses.orient = 0;     // no tilt sensor yet
  senses.touched = touchedPending ? 1 : 0;
  touchedPending = false;
}

// ================================================================ brain

int sampleAction(const float *logits) {
  float mx = logits[0];
  for (int i = 1; i < PIP_N_ACTIONS; i++) mx = max(mx, logits[i]);
  float sum = 0;
  for (int i = 0; i < PIP_N_ACTIONS; i++) {
    actionProbs[i] = expf(logits[i] - mx);
    sum += actionProbs[i];
  }
  for (int i = 0; i < PIP_N_ACTIONS; i++) actionProbs[i] /= sum;
  float r = (esp_random() / 4294967296.0f), acc = 0;
  for (int i = 0; i < PIP_N_ACTIONS; i++) {
    acc += actionProbs[i];
    if (r < acc) return i;
  }
  return PIP_N_ACTIONS - 1;
}

// A short human explanation of why Pip probably chose this.
void explain(int a) {
  bool night = senses.hour >= 22 || senses.hour < 7;
  const char *r = "";
  switch (a) {
    case A_NAP:
      r = pip.energy < 0.4f ? "I'm so tired..." : night ? "It's night-time, zzz" : traits.lazy > 0.6f ? "Naps are the best" : "Just resting my eyes";
      break;
    case A_EAT:
      r = pip.food < 0.4f ? "My tummy is rumbling!" : "Snack time!";
      break;
    case A_EXPLORE:
      r = pip.novelty > 0.3f ? "Something changed! Let me see" : traits.curious > 0.6f ? "What's over there?" : "Having a little wander";
      break;
    case A_PLAY:
      r = pip.touchRecent > 0.3f ? "Play with me!" : "Bouncing around for fun";
      break;
    case A_SING:
      r = pip.touchRecent > 0.3f ? "A song for you!" : "La la la~";
      break;
    case A_HIDE:
      r = senses.orient >= 2 ? "Whoa, everything's tilted!" : traits.brave < 0.35f ? "Feeling shy..." : "Hiding in my box";
      break;
    case A_WARM_UP:
      r = senses.tempC < 18 ? "Brr, it's cold in here" : "Getting cosy";
      break;
    case A_COOL_DOWN:
      r = senses.tempC > 26 ? "Phew, it's hot!" : "Cooling off";
      break;
    case A_CALL:
      r = senses.battery < 0.3f && !senses.charging ? "My battery is low! Charge me?" :
          pip.social < 0.4f ? "Hello? Anyone there?" : "Hey! Over here!";
      break;
    default:
      r = pip.comfort > 0.7f ? "Life is good" : "Just hanging out";
  }
  snprintf(reason, sizeof(reason), "%s", r);
}

void think() {
  readSenses();
  pip_observe(&pip, &senses);
  float x[PIP_N_FEATURES], logits[PIP_N_ACTIONS];
  pip_features(&pip, &senses, &traits, x);
  pip_brain(x, logits);
  action = sampleAction(logits);
  explain(action);
  pip_act(&pip, &senses, &traits, action);
  thoughts++;

  int hr = (int)senses.hour, mn = (int)((senses.hour - hr) * 60);
  memmove(&actionLog[1], &actionLog[0], sizeof(LogEntry) * (LOG_LEN - 1));
  actionLog[0] = {action, hr, mn};
  if (logCount < LOG_LEN) logCount++;

  saveState();
  Serial.printf("[%02d:%02d] %.1fC %.0f%% bat %.2f | food %.2f energy %.2f fun %.2f comfort %.2f social %.2f -> %s (%.0f%%) \"%s\"\n",
                hr, mn, senses.tempC, senses.humidity, senses.battery, pip.food, pip.energy, pip.fun, pip.comfort,
                pip.social, PIP_ACTION_NAMES[action], actionProbs[action] * 100, reason);
  startAction(action);
  needRedraw = true;
}

// ================================================================ saving

void saveState() {
  prefs.putBytes("state", &pip, sizeof(pip));
  prefs.putInt("action", action);
  prefs.putULong("thoughts", thoughts);
}

void loadOrBirth() {
  if (prefs.getBytesLength("traits") == sizeof(traits)) {
    prefs.getBytes("traits", &traits, sizeof(traits));
  } else {  // a new Pip is born with a random personality
    float *t = &traits.curious;
    for (int i = 0; i < 5; i++) t[i] = esp_random() / 4294967296.0f;
    prefs.putBytes("traits", &traits, sizeof(traits));
    Serial.println("A new Pip is born!");
  }
  if (prefs.getBytesLength("state") == sizeof(pip)) {
    prefs.getBytes("state", &pip, sizeof(pip));
    action = prefs.getInt("action", A_IDLE);
    thoughts = prefs.getULong("thoughts", 0);
    snprintf(reason, sizeof(reason), "I'm back!");
  } else {
    pip_init(&pip, 0.8f, 0.8f, 0.8f, 0.8f, 0.8f);
    snprintf(reason, sizeof(reason), "Hello world! I'm new here.");
  }
}

// Describe the personality in a few words, e.g. "curious & lazy".
String personalityWords() {
  const char *names[5] = {"curious", "playful", "lazy", "brave", "cuddly"};
  const float *t = &traits.curious;
  int a = 0, b = 1;
  if (t[b] > t[a]) { a = 1; b = 0; }
  for (int i = 2; i < 5; i++) {
    if (t[i] > t[a]) { b = a; a = i; }
    else if (t[i] > t[b]) b = i;
  }
  String s = names[a];
  if (t[b] > 0.5f) s += String(" & ") + names[b];
  if (traits.brave < 0.2f) s += ", shy";
  return s;
}

