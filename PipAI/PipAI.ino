// ================================================================ sensors

bool readSHTC3(float &tempC, float &humidity) {
  auto cmd = [](uint16_t c) {
    Wire.beginTransmission(SHTC3_ADDR);
    Wire.write(c >> 8);
    Wire.write(c & 0xFF);
    return Wire.endTransmission() == 0;
  };
  if (!cmd(0x3517)) return false;  // wake
  delay(1);
  if (!cmd(0x7866)) return false;  // measure, T first
  delay(20);
  if (Wire.requestFrom(SHTC3_ADDR, (uint8_t)6) != 6) return false;
  uint16_t rawT = (Wire.read() << 8) | Wire.read(); Wire.read();
  uint16_t rawH = (Wire.read() << 8) | Wire.read(); Wire.read();
  cmd(0xB098);  // sleep
  tempC = -45.0f + 175.0f * rawT / 65536.0f;
  humidity = 100.0f * rawH / 65536.0f;
  return true;
}

uint8_t bcd2dec(uint8_t v) { return (v >> 4) * 10 + (v & 0x0F); }
uint8_t dec2bcd(uint8_t v) { return ((v / 10) << 4) | (v % 10); }

// Read hour/minute from the PCF85063 clock chip. Returns false if never set.
bool readRtc(int &hour, int &minute) {
  Wire.beginTransmission(RTC_ADDR);
  Wire.write(0x04);
  if (Wire.endTransmission(false) != 0) return false;
  if (Wire.requestFrom(RTC_ADDR, (uint8_t)7) != 7) return false;
  uint8_t sec = Wire.read(), min = Wire.read(), hr = Wire.read();
  Wire.read(); Wire.read(); Wire.read();
  uint8_t yr = Wire.read();
  if (sec & 0x80) return false;          // oscillator stopped: time not valid
  if (bcd2dec(yr) < 25) return false;    // never set
  minute = bcd2dec(min & 0x7F);
  hour = bcd2dec(hr & 0x3F);
  return true;
}

void writeRtc(int year, int month, int day, int weekday, int hour, int minute, int second) {
  Wire.beginTransmission(RTC_ADDR);
  Wire.write(0x04);
  Wire.write(dec2bcd(second));
  Wire.write(dec2bcd(minute));
  Wire.write(dec2bcd(hour));
  Wire.write(dec2bcd(day));
  Wire.write(weekday);
  Wire.write(dec2bcd(month));
  Wire.write(dec2bcd(year % 100));
  Wire.endTransmission();
}

void readSenses() {
  float t, h;
  haveSensor = readSHTC3(t, h);
  senses.tempC = haveSensor ? t : 21.0f;
  senses.humidity = haveSensor ? h : 45.0f;

  int hr = 12, mn = 0;
  clockSet = readRtc(hr, mn);
  senses.hour = hr + mn / 60.0f;

  // Battery: no battery (USB only) reads as nonsense, so treat that as "plugged in, full".
  float v = analogReadMilliVolts(BAT_ADC) * 2 / 1000.0f;
  if (v > 4.3f || v < 2.8f) {
    senses.battery = 1.0f;
    senses.charging = 1;
  } else {
    senses.battery = pip_clamp01((v - 3.3f) / (4.15f - 3.3f));
    senses.charging = 0;
  }
  senses.sound = 0.0f;   // microphone hearing comes in a later version
  senses.orient = 0;     // no tilt sensor yet
  senses.touched = touchedPending ? 1 : 0;
  touchedPending = false;
}

// ================================================================ brain

int sampleAction(const float *logits) {
  float mx = logits[0];
  for (int i = 1; i < PIP_N_ACTIONS; i++) mx = max(mx, logits[i]);
  float sum = 0;
  for (int i = 0; i < PIP_N_ACTIONS; i++) {
    actionProbs[i] = expf(logits[i] - mx);
    sum += actionProbs[i];
  }
  for (int i = 0; i < PIP_N_ACTIONS; i++) actionProbs[i] /= sum;
  float r = (esp_random() / 4294967296.0f), acc = 0;
  for (int i = 0; i < PIP_N_ACTIONS; i++) {
    acc += actionProbs[i];
    if (r < acc) return i;
  }
  return PIP_N_ACTIONS - 1;
}

// A short human explanation of why Pip probably chose this.
// Which negative feeling (if any) is strongest right now: 0 grumpy, 1 sulky, 2 scared,
// 3 frustrated, or -1 if Pip feels fine.
enum Feeling { F_NONE = -1, F_GRUMPY, F_SULKY, F_SCARED, F_FRUSTRATED };
int strongestFeeling(float threshold) {
  float v[4] = {pip.grumpy, pip.sulky, pip.scared, pip.frustrated};
  int best = -1;
  for (int i = 0; i < 4; i++) if (v[i] > threshold && (best < 0 || v[i] > v[best])) best = i;
  return best;
}

void explain(int a) {
  bool night = senses.hour >= 22 || senses.hour < 7;
  const char *r = "";
  switch (strongestFeeling(0.35f)) {  // a strong feeling colours everything
    case F_GRUMPY:     snprintf(reason, sizeof(reason), "%s", pip.prevAction == A_NAP ? "Hmph. I was napping!" : "Feeling grumpy..."); return;
    case F_SULKY:      snprintf(reason, sizeof(reason), "%s", "Not talking to you. Hmph."); return;
    case F_SCARED:     snprintf(reason, sizeof(reason), "%s", "Eek! That was scary!"); return;
    case F_FRUSTRATED: snprintf(reason, sizeof(reason), "%s", "Grr, it's not working!"); return;
    default: break;
  }
  switch (a) {
    case A_NAP:
      r = pip.energy < 0.4f ? "I'm so tired..." : night ? "It's night-time, zzz" : traits.lazy > 0.6f ? "Naps are the best" : "Just resting my eyes";
      break;
    case A_EAT:
      r = pip.food < 0.4f ? "My tummy is rumbling!" : "Snack time!";
      break;
    case A_EXPLORE:
      r = pip.novelty > 0.3f ? "Something changed! Let me see" : traits.curious > 0.6f ? "What's over there?" : "Having a little wander";
      break;
    case A_PLAY:
      r = pip.touchRecent > 0.3f ? "Play with me!" : "Bouncing around for fun";
      break;
    case A_SING:
      r = pip.touchRecent > 0.3f ? "A song for you!" : "La la la~";
      break;
    case A_HIDE:
      r = senses.orient >= 2 ? "Whoa, everything's tilted!" : traits.brave < 0.35f ? "Feeling shy..." : "Hiding in my box";
      break;
    case A_WARM_UP:
      r = senses.tempC < 18 ? "Brr, it's cold in here" : "Getting cosy";
      break;
    case A_COOL_DOWN:
      r = senses.tempC > 26 ? "Phew, it's hot!" : "Cooling off";
      break;
    case A_CALL:
      r = senses.battery < 0.3f && !senses.charging ? "My battery is low! Charge me?" :
          pip.social < 0.4f ? "Hello? Anyone there?" : "Hey! Over here!";
      break;
    case A_DANCE:
      r = pip.touchRecent > 0.3f ? "Dancing for you!" : traits.playful > 0.6f ? "Can't stop the groove" : "Dance break!";
      break;
    case A_WINDOW:
      r = (clockSet && (senses.hour >= 20 || senses.hour < 7)) ? "Looking at the moon" :
          traits.curious > 0.6f ? "What's out there?" : "Watching the sky";
      break;
    default:
      r = pip.comfort > 0.7f ? "Life is good" : "Just hanging out";
  }
  snprintf(reason, sizeof(reason), "%s", r);
}

void think() {
  readSenses();
  pip_observe(&pip, &senses);
  float x[PIP_N_FEATURES], logits[PIP_N_ACTIONS];
  pip_features(&pip, &senses, &traits, x);
  brainForward(x, logits);  // the trained brain plus whatever Pip has learned on the board
  action = sampleAction(logits);
  explain(action);
  float night = (clockSet && (senses.hour >= 22 || senses.hour < 7)) ? 1.0f : 0.0f;
  pip_act(&pip, &senses, &traits, action);
  lastReward = pip_reward(&pip, &traits, action, night);
  learnFrom(action, lastReward);  // nudge the brain toward choices that turned out well
  thoughts++;
  diaryWrite(action, lastReward);

  int hr = (int)senses.hour, mn = (int)((senses.hour - hr) * 60);
  memmove(&actionLog[1], &actionLog[0], sizeof(LogEntry) * (LOG_LEN - 1));
  actionLog[0] = {action, hr, mn};
  if (logCount < LOG_LEN) logCount++;

  saveState();
  Serial.printf("[%02d:%02d] %.1fC %.0f%% bat %.2f | food %.2f energy %.2f fun %.2f comfort %.2f social %.2f -> %s (%.0f%%) \"%s\"\n",
                hr, mn, senses.tempC, senses.humidity, senses.battery, pip.food, pip.energy, pip.fun, pip.comfort,
                pip.social, PIP_ACTION_NAMES[action], actionProbs[action] * 100, reason);
  startAction(action);
  needRedraw = true;
}

// ================================================================ learning on the board
// Pip keeps learning from its own life. After each decision it scores how things went
// (the same reward it was trained with) and nudges the brain's last layer: choices that
// went better than usual become a bit more likely, worse ones a bit less (REINFORCE).
// What it learns is saved, and is reset when a new brain version arrives from GitHub.

float liveW3[PIP_N_OUT * PIP_N_HID], liveB3[PIP_N_OUT];
float lastH2[PIP_N_HID];
float rewardBaseline = 0, recentReward = 0, lastReward = 0;
bool baselineSet = false;
unsigned long learnSteps = 0;
const float LEARN_RATE = 0.002f;   // small steps: Pip changes slowly, over days
const float MAX_DRIFT = 1.0f;      // never drift further than this from the trained brain
Preferences learnPrefs;

void brainForward(const float *x, float *logits) {
  pip_hidden(x, lastH2);   // layers 1-2 (8-bit weights from training)
  pip_dense(liveW3, liveB3, lastH2, PIP_N_HID, PIP_N_OUT, logits, 0);  // layer 3, which keeps learning
}

void saveLearning() {
  learnPrefs.putUInt("ver", PIP_BRAIN_VERSION);
  learnPrefs.putBytes("w3", liveW3, sizeof(liveW3));
  learnPrefs.putBytes("b3", liveB3, sizeof(liveB3));
  learnPrefs.putFloat("base", rewardBaseline);
  learnPrefs.putFloat("recent", recentReward);
  learnPrefs.putULong("steps", learnSteps);
}

void loadLearning() {
  memcpy(liveW3, PIP_W3, sizeof(liveW3));
  memcpy(liveB3, PIP_B3, sizeof(liveB3));
  learnPrefs.begin("learn", false);
  if (learnPrefs.getUInt("ver", 0xFFFFFFFF) == (uint32_t)PIP_BRAIN_VERSION &&
      learnPrefs.getBytesLength("w3") == sizeof(liveW3) && learnPrefs.getBytesLength("b3") == sizeof(liveB3)) {
    learnPrefs.getBytes("w3", liveW3, sizeof(liveW3));
    learnPrefs.getBytes("b3", liveB3, sizeof(liveB3));
    rewardBaseline = learnPrefs.getFloat("base", 0);
    recentReward = learnPrefs.getFloat("recent", 0);
    learnSteps = learnPrefs.getULong("steps", 0);
    baselineSet = learnSteps > 0;
    Serial.printf("Loaded %lu steps of on-board learning\n", learnSteps);
  } else {
    Serial.println("New brain version: on-board learning starts fresh");
  }
}

void learnFrom(int a, float r) {
  if (!baselineSet) { rewardBaseline = recentReward = r; baselineSet = true; }
  float adv = constrain(r - rewardBaseline, -1.0f, 1.0f);   // better or worse than usual?
  rewardBaseline += 0.02f * (r - rewardBaseline);
  recentReward += 0.05f * (r - recentReward);
  for (int i = 0; i < PIP_N_OUT; i++) {
    float g = LEARN_RATE * adv * (((i == a) ? 1.0f : 0.0f) - actionProbs[i]);
    for (int k = 0; k < PIP_N_HID; k++) {
      int j = i * PIP_N_HID + k;
      liveW3[j] = constrain(liveW3[j] + g * lastH2[k], PIP_W3[j] - MAX_DRIFT, PIP_W3[j] + MAX_DRIFT);
    }
    liveB3[i] = constrain(liveB3[i] + g, PIP_B3[i] - MAX_DRIFT, PIP_B3[i] + MAX_DRIFT);
  }
  learnSteps++;
  if (learnSteps % 10 == 0) saveLearning();
}

// How far on-board learning has moved the brain (0 = not at all).
float learnedDrift() {
  float d = 0;
  for (int j = 0; j < PIP_N_OUT * PIP_N_HID; j++) d += fabsf(liveW3[j] - PIP_W3[j]);
  return d / (PIP_N_OUT * PIP_N_HID);
}

// ================================================================ diary on the microSD card
// Every decision goes into /pip/diary.csv and everything Pip says into /pip/sayings.txt.
// Download them from the phone page, or read the card on a computer.
bool sdOk = false;

void startSD() {
  SD_MMC.setPins(39, 41, 40);                    // CLK, CMD, D0 (1-bit mode, from Waveshare's example)
  sdOk = SD_MMC.begin("/sdcard", true);
  if (!sdOk) { Serial.println("No microSD card (diary off)"); return; }
  SD_MMC.mkdir("/pip");
  if (SD_MMC.exists("/pip/diary.csv")) {  // older diaries didn't have the feelings columns
    File f = SD_MMC.open("/pip/diary.csv", FILE_READ);
    String header = f ? f.readStringUntil('\n') : "";
    if (f) f.close();
    if (header.indexOf("grumpy") < 0) { SD_MMC.remove("/pip/diary-old.csv"); SD_MMC.rename("/pip/diary.csv", "/pip/diary-old.csv"); }
  }
  if (!SD_MMC.exists("/pip/diary.csv")) {
    File f = SD_MMC.open("/pip/diary.csv", FILE_WRITE);
    if (f) { f.println("thought,time,temp_c,humidity,battery,petted,food,energy,fun,comfort,love,grumpy,sulky,scared,frustrated,action,chance,reward,brain_version"); f.close(); }
  }
  Serial.printf("microSD card: %llu MB, diary on\n", SD_MMC.cardSize() / (1024 * 1024));
}

void diaryWrite(int a, float r) {
  if (!sdOk) return;
  File f = SD_MMC.open("/pip/diary.csv", FILE_APPEND);
  if (!f) return;
  int hr = (int)senses.hour, mn = (int)((senses.hour - hr) * 60);
  f.printf("%lu,%s%02d:%02d,%.1f,%.0f,%.2f,%d,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%s,%.2f,%.3f,%d\n", thoughts,
           clockSet ? "" : "~", hr, mn, senses.tempC, senses.humidity, senses.battery, senses.touched,
           pip.food, pip.energy, pip.fun, pip.comfort, pip.social, pip.grumpy, pip.sulky, pip.scared, pip.frustrated,
           PIP_ACTION_NAMES[a], actionProbs[a], r,
           PIP_BRAIN_VERSION);
  f.close();
}

void diarySaid(const char *text) {
  if (!sdOk) return;
  File f = SD_MMC.open("/pip/sayings.txt", FILE_APPEND);
  if (!f) return;
  int hr = (int)senses.hour, mn = (int)((senses.hour - hr) * 60);
  f.printf("%s%02d:%02d  %s\n", clockSet ? "" : "~", hr, mn, text);
  f.close();
}

// ================================================================ updating itself over Wi-Fi
// Every hour Pip asks GitHub for the newest version number. If it's newer than this
// program, it downloads the update over HTTPS (checked against GitHub's real
// certificates, see pip_github_roots.h), installs it into the spare slot and restarts.
const char *UPDATE_BASE = "https://github.com/atrociouslyterrific/esp32-epaper-projects/releases/download/latest/";
unsigned long nextUpdateCheck = 3UL * 60 * 1000;   // first check 3 minutes after starting
String updateStatus = "not checked yet";
int latestVersion = -1;

int fetchLatestVersion() {
  WiFiClientSecure client;
  client.setCACert(GITHUB_ROOT_CAS);
  HTTPClient http;
  http.setFollowRedirects(HTTPC_STRICT_FOLLOW_REDIRECTS);
  http.setTimeout(15000);
  if (!http.begin(client, String(UPDATE_BASE) + "PipAI.version")) return -1;
  int code = http.GET();
  int v = -1;
  if (code == 200) v = http.getString().toInt();
  else Serial.printf("Update check: HTTP %d\n", code);
  http.end();
  return v > 0 ? v : -1;
}

void checkForUpdate() {
  if (WiFi.status() != WL_CONNECTED || setupMode) { updateStatus = "waiting for Wi-Fi"; return; }
  latestVersion = fetchLatestVersion();
  if (latestVersion < 0) { updateStatus = "couldn't reach GitHub"; return; }
  if (latestVersion <= PIP_FW_VERSION) { updateStatus = "up to date"; return; }

  Serial.printf("Updating from version %d to %d\n", PIP_FW_VERSION, latestVersion);
  snprintf(reason, sizeof(reason), "Updating myself to v%d...", latestVersion);
  snprintf(speech, sizeof(speech), "Brb, getting smarter!");
  speechUntil = millis() + 600000UL;
  saveState();
  saveLearning();
  drawScreen();

  WiFiClientSecure client;
  client.setCACert(GITHUB_ROOT_CAS);
  httpUpdate.setFollowRedirects(HTTPC_STRICT_FOLLOW_REDIRECTS);
  httpUpdate.rebootOnUpdate(true);  // restarts into the new version when it's done
  t_httpUpdate_return ret = httpUpdate.update(client, String(UPDATE_BASE) + "PipAI-ota.bin");
  if (ret == HTTP_UPDATE_FAILED) {
    updateStatus = "update failed: " + httpUpdate.getLastErrorString();
    Serial.println(updateStatus);
    snprintf(reason, sizeof(reason), "Update failed, retry tomorrow");
    speech[0] = 0;
    needRedraw = true;
  }
}

void updateTick() {
  if (millis() < nextUpdateCheck) return;
  nextUpdateCheck = millis() + 60UL * 60 * 1000;  // then every hour (GitHub trains every hour)
  checkForUpdate();
}

// ================================================================ saving

void saveState() {
  prefs.putBytes("state", &pip, sizeof(pip));
  prefs.putInt("action", action);
  prefs.putULong("thoughts", thoughts);
}

void loadOrBirth() {
  if (prefs.getBytesLength("traits") == sizeof(traits)) {
    prefs.getBytes("traits", &traits, sizeof(traits));
  } else {  // a new Pip is born with a random personality
    float *t = &traits.curious;
    for (int i = 0; i < 5; i++) t[i] = esp_random() / 4294967296.0f;
    prefs.putBytes("traits", &traits, sizeof(traits));
    Serial.println("A new Pip is born!");
  }
  if (prefs.getBytesLength("state") == sizeof(pip)) {
    prefs.getBytes("state", &pip, sizeof(pip));
    action = prefs.getInt("action", A_IDLE);
    thoughts = prefs.getULong("thoughts", 0);
    snprintf(reason, sizeof(reason), "I'm back!");
  } else {
    pip_init(&pip, 0.8f, 0.8f, 0.8f, 0.8f, 0.8f);
    snprintf(reason, sizeof(reason), "Hello world! I'm new here.");
  }
}

// Describe the personality in a few words, e.g. "curious & lazy".
String personalityWords() {
  const char *names[5] = {"curious", "playful", "lazy", "brave", "cuddly"};
  const float *t = &traits.curious;
  int a = 0, b = 1;
  if (t[b] > t[a]) { a = 1; b = 0; }
  for (int i = 2; i < 5; i++) {
    if (t[i] > t[a]) { b = a; a = i; }
    else if (t[i] > t[b]) b = i;
  }
  String s = names[a];
  if (t[b] > 0.5f) s += String(" & ") + names[b];
  if (traits.brave < 0.2f) s += ", shy";
  return s;
}

// ================================================================ drawing + movement
// Pip is a squishy blob living in a little room: a bed (left), a food bowl and a cardboard box (right),
// and a window that shows the sun or the moon. Pip walks to the right place for
// each action and jumps when it plays or gets petted.

const int FLOOR_Y = 106, BLOB_RX = 19, BLOB_RY = 16;
const int BED_X = 28, BOWL_X = 140, BOX_X = 181;
const int WALK_STEP = 7;                // pixels per frame when sliding along
const int FULL_REFRESH_AFTER = 150;     // clear e-paper ghosting, but only while Pip is resting

enum AnimMode { AN_REST, AN_WALK, AN_PERFORM };
AnimMode animMode = AN_REST;
int pipX = 100, pipJump = 0, squash = 100, facing = 1, legPhase = 0, targetX = 100;
int performStep = 0, exploreHops = 0, partialsSinceFull = 0;
bool fullRefreshDue = false;
unsigned long nextFrameAt = 0, nextAmbientAt = 0;

// Squash-and-stretch keyframes: {height above floor, squash %}.
// squash > 100 = wider and flatter (landing), < 100 = taller and thinner (taking off).
const Key K_PLAY[] = {{0,128},{-7,80},{-17,90},{-22,100},{-17,94},{-7,84},{0,132},{0,108},
                      {0,124},{-8,80},{-18,92},{-22,100},{-14,90},{0,130},{0,106},{0,100}};
const Key K_HOP[]  = {{0,124},{-8,84},{-12,96},{-6,90},{0,126},{0,106},{0,100}};
const Key K_CALL[] = {{0,120},{-6,86},{-9,96},{0,124},{-6,86},{-9,96},{0,120},{0,100}};
const Key K_SING[] = {{0,106},{-1,94},{0,106},{-1,94},{0,106},{0,100}};
const Key K_DANCE[] = {{0,120},{-6,86},{0,124},{-3,92},{0,118},{-8,84},{-12,96},{0,128},{0,110},{-6,86},{0,124},{0,100}};
const Key K_LOOK[]  = {{0,96},{-2,92},{-2,92},{0,98},{0,100}};  // stretches up to see out
const Key K_EAT[]  = {{0,112},{0,96},{0,112},{0,96},{0,100}};
const Key K_SHIVER[] = {{0,104},{0,98},{0,104},{0,98},{0,100}};
const Key *keys = nullptr;
int keyLen = 0;

void drawArc(int cx, int cy, int halfWidth, int curve, int thick) {
  for (int t = 0; t < thick; t++) {
    int px = cx - halfWidth, py = cy + t;
    for (int x = -halfWidth + 1; x <= halfWidth; x++) {
      float k = 1.0f - (float)(x * x) / (halfWidth * halfWidth);
      int y = cy + t + (int)(curve * k);
      display.drawLine(px, py, cx + x, y, GxEPD_BLACK);
      px = cx + x; py = y;
    }
  }
}

void drawNote(int x, int y) {
  display.fillCircle(x, y, 2, GxEPD_BLACK);
  display.drawLine(x + 2, y, x + 2, y - 8, GxEPD_BLACK);
  display.drawLine(x + 2, y - 8, x + 6, y - 6, GxEPD_BLACK);
}

void printAt(const char *text, int x, int y, int size) {
  display.setFont(); display.setTextSize(size); display.setTextColor(GxEPD_BLACK);
  display.setCursor(x, y); display.print(text);
}

void printCentered(const char *text, int y, int size) {
  printAt(text, (200 - (int)strlen(text) * 6 * size) / 2, y, size);
}

void drawBar(int y, const char *label, float v) {
  printAt(label, 4, y, 1);
  display.drawRect(50, y, 146, 8, GxEPD_BLACK);
  display.fillRect(52, y + 2, (int)(142 * v), 4, GxEPD_BLACK);
}

void drawRoom() {
  bool night = clockSet && (senses.hour >= 20 || senses.hour < 7);
  // Window with the sun or moon (it knows the time from the clock chip)
  display.drawRect(86, 18, 30, 24, GxEPD_BLACK);
  display.drawLine(101, 18, 101, 41, GxEPD_BLACK);
  display.drawLine(86, 30, 115, 30, GxEPD_BLACK);
  if (night) {
    display.fillCircle(94, 24, 4, GxEPD_BLACK);
    display.fillCircle(96, 23, 4, GxEPD_WHITE);
    display.drawPixel(109, 22, GxEPD_BLACK); display.drawPixel(107, 36, GxEPD_BLACK); display.drawPixel(92, 37, GxEPD_BLACK);
  } else {
    display.drawCircle(94, 24, 3, GxEPD_BLACK);
    for (int i = 0; i < 8; i++) {
      float a = i * PI / 4;
      display.drawPixel(94 + (int)(6 * cosf(a)), 24 + (int)(6 * sinf(a)), GxEPD_BLACK);
    }
  }
  // Floor
  display.drawLine(0, FLOOR_Y, 199, FLOOR_Y, GxEPD_BLACK);
