  j += "\"updateStatus\":\"" + jsonEscape(updateStatus.c_str()) + "\",\"latest\":" + String(latestVersion) + ",";
  j += "\"sd\":" + String(sdOk ? "true" : "false") + ",";
  j += "\"bloopHere\":" + String(bloopHere ? "true" : "false") + ",";
  j += "\"log\":[";
  for (int i = 0; i < logCount; i++) {
    char e[48];
    snprintf(e, sizeof(e), "%02d:%02d %s", actionLog[i].hour, actionLog[i].minute, PIP_ACTION_NAMES[actionLog[i].action]);
    j += String(i ? "," : "") + "\"" + e + "\"";
  }
  j += "]}";
  server.send(200, "application/json", j);
}

void sendSdFile(const char *path, const char *type) {
  if (!sdOk || !SD_MMC.exists(path)) { server.send(404, "text/plain", "Nothing on the microSD card yet."); return; }
  File f = SD_MMC.open(path, FILE_READ);
  server.streamFile(f, type);
  f.close();
}

void handlePet() {
  petPip();
  sendState();
}

void handleTime() {
  if (server.hasArg("y")) {
    writeRtc(server.arg("y").toInt(), server.arg("mo").toInt(), server.arg("d").toInt(), server.arg("wd").toInt(),
             server.arg("h").toInt(), server.arg("mi").toInt(), server.arg("s").toInt());
    int hr, mn;
    clockSet = readRtc(hr, mn);
    if (clockSet) senses.hour = hr + mn / 60.0f;
  }
  server.send(200, "text/plain", clockSet ? "ok" : "no clock");
}

void startSetupMode() {
  if (setupMode) return;
  setupMode = true;
  WiFi.mode(WIFI_AP_STA);
  int n = WiFi.scanNetworks();
  networkOptions = "";
  for (int i = 0; i < n; i++) {
    String name = WiFi.SSID(i);
    if (name.length() == 0 || networkOptions.indexOf(">" + htmlEscape(name) + "<") >= 0) continue;
    networkOptions += "<option value=\"" + htmlEscape(name) + "\">" + htmlEscape(name) + "</option>";
  }
  WiFi.softAP(SETUP_WIFI_NAME);
  dnsServer.start(53, "*", WiFi.softAPIP());
  snprintf(reason, sizeof(reason), "Join WiFi %s to set me up", SETUP_WIFI_NAME);
  needRedraw = true;
}

void handleRoot() {
  if (setupMode) {
    String page = FPSTR(SETUP_HTML_TOP);
    page += networkOptions;
    page += FPSTR(SETUP_HTML_BOTTOM);
    server.send(200, "text/html", page);
  } else {
    server.send_P(200, "text/html", PAGE_HTML);
  }
}

void handleSave() {
  String ssid = server.arg("other");
  ssid.trim();
  if (ssid.length() == 0) ssid = server.arg("ssid");
  wifiPrefs.putString("ssid", ssid);
  wifiPrefs.putString("pass", server.arg("pass"));
  server.send(200, "text/html",
              "<meta name=viewport content='width=device-width'><body style='font-family:sans-serif;padding:20px'>"
              "<h2>Saved!</h2><p>Pip is restarting and joining <b>" + htmlEscape(ssid) +
              "</b>.</p><p>Switch your phone back to your home Wi-Fi, then open <b>http://pip.local</b>.</p></body>");
  delay(1500);
  ESP.restart();
}

void handleNotFound() {
  if (setupMode) {
    server.sendHeader("Location", "http://" + WiFi.softAPIP().toString() + "/", true);
    server.send(302, "text/plain", "");
  } else {
    server.send(404, "text/plain", "Not found");
  }
}

void forgetWifi() {
  wifiPrefs.clear();
  snprintf(reason, sizeof(reason), "WiFi forgotten!");
  drawScreen();
  delay(1000);
  ESP.restart();
}

void startWifi() {
  wifiPrefs.begin("wifi", false);
  savedSsid = wifiPrefs.getString("ssid", "");
  savedPass = wifiPrefs.getString("pass", "");

  // Wi-Fi must be switched on BEFORE the web server starts, or the network
  // system isn't ready yet and the board crashes and restarts in a loop.
  WiFi.setHostname(WEB_NAME);
  WiFi.mode(WIFI_STA);
  server.on("/", handleRoot);
  server.on("/state", sendState);
  server.on("/pet", handlePet);
  server.on("/time", handleTime);
  server.on("/snack", []() { dropSnack(); sendState(); });
  server.on("/update", []() { checkForUpdate(); sendState(); });
  server.on("/diary", []() { sendSdFile("/pip/diary.csv", "text/csv"); });
  server.on("/sayings", []() { sendSdFile("/pip/sayings.txt", "text/plain"); });
  server.on("/save", HTTP_POST, handleSave);
  server.onNotFound(handleNotFound);
  server.begin();
  if (savedSsid.length() == 0) { startSetupMode(); return; }
  WiFi.begin(savedSsid.c_str(), savedPass.c_str());
  wifiStartedAt = lastWifiAttempt = millis();
}

void checkWifi() {
  if (setupMode) dnsServer.processNextRequest();
  if (savedSsid.length() == 0) return;
  if (!setupMode && !wifiWasConnected && WiFi.status() != WL_CONNECTED && millis() - wifiStartedAt > 30000) {
    startSetupMode();
  }
  bool connected = WiFi.status() == WL_CONNECTED;
  if (connected && !wifiWasConnected) {
    if (setupMode) {
      dnsServer.stop();
      WiFi.softAPdisconnect(true);
      WiFi.mode(WIFI_STA);
      setupMode = false;
    }
    configTime(0, 0, "pool.ntp.org", "time.google.com");  // correct time for HTTPS certificate checks
    MDNS.begin(WEB_NAME);
    MDNS.addService("http", "tcp", 80);
    Serial.printf("Wi-Fi connected: http://%s.local or http://%s\n", WEB_NAME, WiFi.localIP().toString().c_str());
    snprintf(reason, sizeof(reason), "Visit me: %s", WiFi.localIP().toString().c_str());
    needRedraw = true;
  } else if (!connected && wifiWasConnected) {
    MDNS.end();
  }
  if (!connected && !setupMode && millis() - lastWifiAttempt > 30000) {
    WiFi.reconnect();
    lastWifiAttempt = millis();
  }
  wifiWasConnected = connected;
}

// ================================================================ buttons

// The screen takes about half a second per frame, and the program can't look at the
// buttons while a frame is being drawn. So the buttons use interrupts: the instant
// a button changes, these tiny functions note it down, and checkButtons() acts on
// it right after the frame. (They read the GPIO register directly so they're safe
// to run at any moment.)
volatile bool isrBootDown = false, isrBootTap = false, isrPwrTap = false;
volatile unsigned long isrBootDownAt = 0, isrPwrAt = 0;
bool bootHoldUsed = false;

void IRAM_ATTR onBootChange() {
  unsigned long now = millis();
  bool down = !(REG_READ(GPIO_IN_REG) & BIT(BTN_BOOT));
  if (down && !isrBootDown) { isrBootDown = true; isrBootDownAt = now; }
  else if (!down && isrBootDown) {
    isrBootDown = false;
    unsigned long held = now - isrBootDownAt;
    if (held > 30 && held < 5000) isrBootTap = true;  // a tap (not a bounce, not the 5 s hold)
  }
}

void IRAM_ATTR onPwrPress() {
  unsigned long now = millis();
  if (now - isrPwrAt > 250) { isrPwrAt = now; isrPwrTap = true; }  // ignore switch bounce
}

void startButtons() {
  attachInterrupt(digitalPinToInterrupt(BTN_BOOT), onBootChange, CHANGE);
  attachInterrupt(digitalPinToInterrupt(BTN_PWR), onPwrPress, FALLING);
}

void checkButtons() {
  // Hold BOOT for 5 seconds: forget the Wi-Fi
  if (isrBootDown && !bootHoldUsed && millis() - isrBootDownAt > 5000) { bootHoldUsed = true; forgetWifi(); }
  if (!isrBootDown) bootHoldUsed = false;

  if (isrBootTap) {  // tap BOOT: drop a snack
    isrBootTap = false;
    Serial.println("BOOT tapped: snack!");
    dropSnack();
  }
  if (isrPwrTap) {   // tap PWR: pet Pip
    isrPwrTap = false;
    Serial.println("PWR tapped: pats!");
    petPip();
  }
}

// How Pip reacts to a pat depends on how it feels.
void petPip() {
  touchedPending = true;  // the brain feels it on its next thought (and updates the feelings)
  if (pip.sulky > 0.4f) {
    pip.sulky = pip_clamp01(pip.sulky - 0.15f);  // it's working... a little
    snprintf(reason, sizeof(reason), "...hmph.");
    speak('U', 8000);
  } else if (action == A_NAP && animMode == AN_REST) {
    pip.grumpy = pip_clamp01(pip.grumpy + 0.3f * (0.6f + 0.8f * traits.lazy));
    snprintf(reason, sizeof(reason), "Hmph! I was napping!");
    speak('G', 8000);
  } else {
    snprintf(reason, sizeof(reason), "Ooh, pats! <3");
    startHop();
    sayPetted();
  }
  needRedraw = true;
}

// ================================================================ radio: Pip and Bloop
// (See "Bloop comes to visit" above.)

void palOnRecv(const esp_now_recv_info_t *info, const uint8_t *data, int len) {
  (void)info;
  if (len < (int)sizeof(PalMsg) || memcmp(data, "PAL1", 4) != 0 || data[4] != PAL_BLOOP) return;
  bloopFlags = data[6];
  bloopHosting = data[7] != 0;
  bloopHeardMs = millis();
}

// "I'm Pip, I'm here": sent 4 times a second by a timer, so it keeps going even
// while the screen is busy drawing.
void palBeacon() {
  PalMsg m = {{'P', 'A', 'L', '1'}, PAL_PIP, palAction, palFlags, 0};
  esp_now_send(PAL_EVERYONE, (const uint8_t *)&m, sizeof(m));
}

void palStart() {
  if (esp_now_init() != ESP_OK) { Serial.println("Radio to Bloop: couldn't start"); return; }
  esp_now_register_recv_cb(palOnRecv);
  esp_now_peer_info_t peer = {};
  memcpy(peer.peer_addr, PAL_EVERYONE, 6);
  peer.channel = 0;   // whatever channel the Wi-Fi is on
  peer.ifidx = WIFI_IF_STA;
  peer.encrypt = false;
  palReady = esp_now_add_peer(&peer) == ESP_OK;
  if (palReady) palTicker.attach_ms(250, palBeacon);
}

// Run from loop(): notice Bloop arriving and leaving.
void visitTick() {
  if (!palReady) return;
  bool sad = min(min(pip.food, pip.energy), min(pip.fun, min(pip.comfort, pip.social))) < 0.25f;
  palAction = (uint8_t)action;
  palFlags = (sad ? PALF_SAD : 0) | (action == A_NAP ? PALF_ASLEEP : 0);

  uint32_t heard = bloopHeardMs;   // read this before the clock: the radio can update it at any moment
  bool together = bloopHosting && heard != 0 && millis() - heard < 5000;
  if (together == bloopHere) {
    if (bloopHere && bloopFlags != bloopFlagsDrawn) { bloopFlagsDrawn = bloopFlags; needRedraw = true; }
    return;
  }
  bloopHere = together;
  bloopFlagsDrawn = bloopFlags;
  // Normally the Wi-Fi radio naps between messages to save battery, which makes it
  // miss most of what Bloop says. While they're together, keep it wide awake.
  if (!setupMode) WiFi.setSleep(!bloopHere);
  if (bloopHere) {
    pip.social = pip_clamp01(pip.social + 0.2f);   // a friend came over!
    pip.fun = pip_clamp01(pip.fun + 0.15f);
    snprintf(reason, sizeof(reason), "Bloop came over!");
    if (action != A_NAP) {
      snprintf(speech, sizeof(speech), "Hi Bloop!");
      speechUntil = millis() + 8000;
      if (animMode == AN_REST) startHop();
    }
  } else {
    snprintf(reason, sizeof(reason), "Bye, Bloop!");
  }
  Serial.println(bloopHere ? "Bloop is here" : "Bloop went home");
  needRedraw = true;
}

// ================================================================ main

void setup() {
  pinMode(VBAT_PWR, OUTPUT); digitalWrite(VBAT_PWR, HIGH);
  pinMode(EPD_PWR, OUTPUT); digitalWrite(EPD_PWR, LOW);
  pinMode(BTN_BOOT, INPUT_PULLUP);
  pinMode(BTN_PWR, INPUT_PULLUP);
  startButtons();
  delay(100);
  Serial.begin(115200);
  delay(300);
  Serial.println("PipAI starting");

  Wire.begin(I2C_SDA, I2C_SCL);
  prefs.begin("pipai", false);
  loadOrBirth();
  loadLearning();
  startSD();
  Serial.printf("Personality: curious %.2f playful %.2f lazy %.2f brave %.2f affectionate %.2f (%s)\n",
                traits.curious, traits.playful, traits.lazy, traits.brave, traits.affectionate,
                personalityWords().c_str());

  SPI.begin(EPD_SCK, -1, EPD_MOSI, EPD_CS);
  display.init(115200, true, 2, false);
  display.setRotation(0);

  readSenses();
  for (int i = 0; i < PIP_N_ACTIONS; i++) actionProbs[i] = 0;
  actionProbs[action] = 1;
  drawScreen();
  startWifi();
  palStart();
  lastThink = millis() - THINK_EVERY_MS + 10000;  // first thought 10 s after start
}

void loop() {
  checkButtons();
  server.handleClient();
  checkWifi();
  if (millis() - lastThink >= THINK_EVERY_MS) {
    lastThink = millis();
    think();
  }
  animTick();
  speechTick();
  visitTick();
  updateTick();
  if (needRedraw) {
    needRedraw = false;
    drawScreen();
  }
  delay(20);
}
