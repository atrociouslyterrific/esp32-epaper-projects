void drawBoxFront(int cx, int cy) {
  display.fillRect(BOX_X - 15, cy + 1, 30, FLOOR_Y - cy - 1, GxEPD_WHITE);
  display.drawRect(BOX_X - 15, cy + 1, 30, FLOOR_Y - cy, GxEPD_BLACK);
  display.drawRect(BOX_X - 14, cy + 2, 28, FLOOR_Y - cy - 2, GxEPD_BLACK);
}

// A blob: round on top, flatter and wider where it sits on the floor.
void fillBlob(int cx, int bottom, int rx, int ry, uint16_t color) {
  int cy = bottom - ry;
  for (int dy = -ry; dy <= ry; dy++) {
    float t = (float)dy / ry, k = 1.0f - t * t;
    if (k < 0) k = 0;
    float hw = dy < 0 ? rx * sqrtf(k) : rx * sqrtf(sqrtf(k));
    int w = (int)(hw + 0.5f);
    if (w > 0) display.drawFastHLine(cx - w, cy + dy, 2 * w + 1, color);
  }
}

void drawPip(int a, bool sad) {
  bool walk = animMode == AN_WALK;
  bool onBed = pipX < 52 && (a == A_NAP || a == A_WARM_UP) && !walk;
  int rx = BLOB_RX * squash / 100, ry = BLOB_RY * 100 / squash;
  int cx = pipX + ((!walk && pip.scared > 0.35f) ? (millis() / 120 % 2 ? 1 : -1) : 0);  // scared: trembling
  int bottom = (onBed ? 97 : FLOOR_Y) + pipJump;
  int cy = bottom - ry, top = bottom - 2 * ry;
  int side = cx > 130 ? -1 : 1;  // which side extra bits (notes, "!") go on

  // Shadow on the floor while in the air
  if (pipJump < -2) {
    int sw = rx - (-pipJump) / 3;
    for (int x = -sw; x <= sw; x += 2) display.drawPixel(cx + x, (onBed ? 97 : FLOOR_Y) - 1, GxEPD_BLACK);
  }
  // Body: thick outline, a little tip on top that trails behind when moving, and a shine
  int lean = walk ? -facing * 3 : (pipJump < -4 ? 0 : 1);
  display.fillTriangle(cx - 3, top + 3, cx + 3, top + 3, cx + lean, top - 4, GxEPD_BLACK);
  fillBlob(cx, bottom, rx, ry, GxEPD_BLACK);
  fillBlob(cx, bottom - 2, rx - 2, ry - 2, GxEPD_WHITE);
  drawArc(cx - rx / 2 - 1, top + ry / 2, 3, -2, 1);

  int ey = cy - 1, look = facing * 2, gap = 7 * rx / BLOB_RX;
  int el = cx - gap + look, er = cx + gap + look;
  int my = cy + 6 * 100 / squash;
  int feel = walk ? F_NONE : strongestFeeling(0.35f);
  if (feel == F_GRUMPY) {
    display.drawLine(el - 3, ey, el + 3, ey, GxEPD_BLACK);          // half-shut eyes
    display.drawLine(er - 3, ey, er + 3, ey, GxEPD_BLACK);
    display.drawLine(el - 4, ey - 6, el + 3, ey - 3, GxEPD_BLACK);  // cross brows
    display.drawLine(er + 4, ey - 6, er - 3, ey - 3, GxEPD_BLACK);
    display.drawLine(cx - 4, my, cx + 4, my, GxEPD_BLACK);          // flat mouth
    // a tiny storm cloud
    display.fillCircle(cx - 4, top - 10, 4, GxEPD_BLACK); display.fillCircle(cx + 3, top - 11, 5, GxEPD_BLACK);
    display.drawLine(cx, top - 6, cx - 2, top - 2, GxEPD_BLACK); display.drawLine(cx - 2, top - 2, cx + 1, top - 2, GxEPD_BLACK);
  } else if (feel == F_SULKY) {
    // facing away: the back of a blob has no face, just a "..." over its head
    for (int i = 0; i < 3; i++) display.fillCircle(cx - 6 + i * 6, top - 6, 1, GxEPD_BLACK);
  } else if (feel == F_SCARED) {
    display.drawCircle(el, ey, 4, GxEPD_BLACK); display.drawCircle(er, ey, 4, GxEPD_BLACK);  // wide eyes
    display.fillCircle(el, ey, 1, GxEPD_BLACK); display.fillCircle(er, ey, 1, GxEPD_BLACK);
    drawArc(cx, my, 5, 0, 1); drawArc(cx - 2, my + 1, 2, -1, 1); drawArc(cx + 2, my + 1, 2, -1, 1);  // wobbly mouth
    display.fillTriangle(cx + rx - 3, top + 1, cx + rx - 6, top + 7, cx + rx, top + 7, GxEPD_BLACK);  // sweat drop
    display.fillCircle(cx + rx - 3, top + 8, 3, GxEPD_BLACK);
  } else if (feel == F_FRUSTRATED) {
    display.fillCircle(el, ey, 2, GxEPD_BLACK); display.fillCircle(er, ey, 2, GxEPD_BLACK);
    display.drawLine(el - 4, ey - 5, el + 3, ey - 3, GxEPD_BLACK);
    display.drawLine(er + 4, ey - 5, er - 3, ey - 3, GxEPD_BLACK);
    for (int x = -5; x < 5; x += 2) display.drawLine(cx + x, my + ((x / 2) % 2 ? 1 : -1), cx + x + 2, my + ((x / 2) % 2 ? -1 : 1), GxEPD_BLACK);  // gritted teeth
    display.drawCircle(cx - rx + 2, top - 3, 2, GxEPD_BLACK); display.drawCircle(cx - rx - 2, top - 8, 3, GxEPD_BLACK);  // steam
    display.drawCircle(cx + rx - 2, top - 3, 2, GxEPD_BLACK); display.drawCircle(cx + rx + 2, top - 8, 3, GxEPD_BLACK);
  } else if (walk || a == A_EXPLORE) {  // eyes look where Pip is going
    display.fillCircle(el, ey, 3, GxEPD_BLACK); display.fillCircle(er, ey, 3, GxEPD_BLACK);
    display.drawPixel(el + facing, ey - 1, GxEPD_WHITE); display.drawPixel(er + facing, ey - 1, GxEPD_WHITE);
    drawArc(cx + look, my, 4, 2, 1);
    if (a == A_EXPLORE && !walk) printAt("?", cx + side * (rx + 3) - (side < 0 ? 6 : 0), top - 4, 1);
  } else switch (a) {
    case A_NAP:
      drawArc(el, ey, 3, 2, 1); drawArc(er, ey, 3, 2, 1);
      display.fillCircle(cx + look, my + 1, 1, GxEPD_BLACK);
      printAt("z", cx + rx + 1, top + 2, 1);
      printAt("Z", cx + rx + 6, top - 8, 1);
      break;
    case A_EAT:
      display.fillCircle(el, ey, 3, GxEPD_BLACK); display.fillCircle(er, ey, 3, GxEPD_BLACK);
      if (squash > 100) display.fillCircle(cx + look + facing * 2, my, 3, GxEPD_BLACK);  // chomp
      else drawArc(cx + look + facing * 2, my, 3, 1, 2);
      break;
    case A_PLAY:
      drawArc(el, ey + 1, 3, -3, 1); drawArc(er, ey + 1, 3, -3, 1);
      drawArc(cx + look, my - 1, 7, 4, 2);
      break;
    case A_SING:
      drawArc(el, ey + 1, 3, -2, 1); drawArc(er, ey + 1, 3, -2, 1);
      display.drawCircle(cx + look, my + 1, squash < 100 ? 3 : 2, GxEPD_BLACK);
      drawNote(cx + side * (rx + 4) - (side < 0 ? 6 : 0), cy - 4 - (squash < 100 ? 3 : 0));
      drawNote(cx + side * (rx + 11) - (side < 0 ? 6 : 0), cy - 12 + (squash < 100 ? 3 : 0));
      break;
    case A_WARM_UP:
      display.fillCircle(el, ey, 2, GxEPD_BLACK); display.fillCircle(er, ey, 2, GxEPD_BLACK);
      drawArc(cx, my, 5, 1, 1);
      for (int i = 0; i < 2; i++) {
        display.drawLine(cx - rx - 6, cy - 4 + i * 7, cx - rx - 2, cy - 6 + i * 7, GxEPD_BLACK);
        display.drawLine(cx + rx + 2, cy - 6 + i * 7, cx + rx + 6, cy - 4 + i * 7, GxEPD_BLACK);
      }
      if (onBed) {  // tucked under a blanket
        display.fillRect(cx - rx - 3, cy + 3, 2 * rx + 6, bottom - cy - 3, GxEPD_WHITE);
        display.drawRect(cx - rx - 3, cy + 3, 2 * rx + 6, bottom - cy - 3, GxEPD_BLACK);
        for (int x = cx - rx + 1; x < cx + rx; x += 6) display.drawLine(x, cy + 5, x + 3, cy + 8, GxEPD_BLACK);
      }
      break;
    case A_COOL_DOWN:
      display.fillCircle(el, ey, 3, GxEPD_BLACK); display.fillCircle(er, ey, 3, GxEPD_BLACK);
      drawArc(cx + look, my, 5, -1, 1);
      display.fillTriangle(cx + rx - 4, top + 3, cx + rx - 7, top + 9, cx + rx - 1, top + 9, GxEPD_BLACK);
      display.fillCircle(cx + rx - 4, top + 10, 3, GxEPD_BLACK);
      break;
    case A_CALL: {
      display.fillCircle(el, ey, 3, GxEPD_BLACK); display.fillCircle(er, ey, 3, GxEPD_BLACK);
      display.fillCircle(cx + look, my, 3, GxEPD_BLACK);
      int bx = cx + side * (rx + 3) - (side < 0 ? 10 : 0);
      display.fillRoundRect(bx, top - 6, 10, 14, 3, GxEPD_BLACK);
      display.setFont(); display.setTextSize(1); display.setTextColor(GxEPD_WHITE);
      display.setCursor(bx + 3, top - 2); display.print("!");
      break;
    }
    case A_DANCE:
      drawArc(el, ey + 1, 3, -3, 1); drawArc(er, ey + 1, 3, -3, 1);   // ^ ^
      display.fillCircle(cx + look, my, 3, GxEPD_BLACK);              // singing along
      drawNote(cx - rx - 10, cy - 6 + (pipJump < 0 ? -4 : 0));
      drawNote(cx + rx + 4, cy - 10 + (pipJump < 0 ? 0 : -4));
      break;
    case A_WINDOW:  // gazing up at the window
      display.fillCircle(cx - gap, ey - 2, 3, GxEPD_BLACK); display.fillCircle(cx + gap, ey - 2, 3, GxEPD_BLACK);
      display.drawPixel(cx - gap, ey - 4, GxEPD_WHITE); display.drawPixel(cx + gap, ey - 4, GxEPD_WHITE);
      display.drawCircle(cx, my + 1, 2, GxEPD_BLACK);                 // "ooh"
      display.drawPixel(cx - 8, top - 6, GxEPD_BLACK); display.drawPixel(cx + 9, top - 9, GxEPD_BLACK);  // sparkles
      display.drawPixel(cx - 7, top - 7, GxEPD_BLACK); display.drawPixel(cx + 10, top - 8, GxEPD_BLACK);
      break;
    default:  // idle and hide
      display.fillCircle(el, ey, 3, GxEPD_BLACK); display.fillCircle(er, ey, 3, GxEPD_BLACK);
      display.drawPixel(el + 1, ey - 1, GxEPD_WHITE); display.drawPixel(er + 1, ey - 1, GxEPD_WHITE);
      if (a != A_HIDE) drawArc(cx + look, my - 1, 6, sad ? -3 : 3, 2);
  }
  if (sad && a != A_NAP && !walk && feel == F_NONE) {
    display.drawLine(el - 4, ey - 7, el + 2, ey - 5, GxEPD_BLACK);
    display.drawLine(er + 4, ey - 7, er - 2, ey - 5, GxEPD_BLACK);
  }
  if (a == A_PLAY && !walk) {  // the ball bounces opposite to Pip
    int by = FLOOR_Y - 6 - (pipJump < -10 ? 0 : 14 + pipJump / 2);
    display.drawCircle(cx + side * (rx + 12), by, 6, GxEPD_BLACK);
    display.drawLine(cx + side * (rx + 12) - 6, by, cx + side * (rx + 12) + 6, by, GxEPD_BLACK);
  }
  if (a == A_HIDE && !walk && abs(pipX - BOX_X) < 6) drawBoxFront(cx, cy);
}

// ---- snacks: tap BOOT and a berry drops into the room; Pip scoots over and eats it
int snackX = -1, snackDropY = 0, snackFallSpeed = 0, snackBounces = 0;
bool eatingSnack = false, snackFalling = false;
unsigned long snackCount = 0;

void drawSnack() {
  if (snackX < 0) return;
  int y = FLOOR_Y - 5 - snackDropY;
  display.fillCircle(snackX, y, 4, GxEPD_BLACK);              // a berry
  display.drawPixel(snackX - 1, y - 2, GxEPD_WHITE);           // shine
  display.drawLine(snackX, y - 4, snackX + 2, y - 8, GxEPD_BLACK);  // stem
  display.fillTriangle(snackX + 2, y - 8, snackX + 6, y - 9, snackX + 4, y - 6, GxEPD_BLACK);  // leaf
  if (snackFalling && snackDropY > 8) {  // speed lines while it falls
    for (int i = -1; i <= 1; i++) display.drawLine(snackX + i * 4, y - 12, snackX + i * 4, y - 12 - min(18, snackFallSpeed), GxEPD_BLACK);
  }
  if (snackFalling && snackDropY == 0) {  // a little "thud" on landing
    display.drawLine(snackX - 9, FLOOR_Y - 2, snackX - 6, FLOOR_Y - 4, GxEPD_BLACK);
    display.drawLine(snackX + 9, FLOOR_Y - 2, snackX + 6, FLOOR_Y - 4, GxEPD_BLACK);
  }
}

// One frame of the snack falling from the top of the room (it speeds up, then bounces).
// Returns true while it's still falling.
bool snackFallFrame() {
  if (!snackFalling) return false;
  if (snackDropY > 0) {
    snackDropY = max(0, snackDropY - snackFallSpeed);
    snackFallSpeed += 9;                       // gravity
  } else if (snackBounces < 2) {
    snackDropY = snackBounces == 0 ? 6 : 2;    // bounce, then a smaller bounce
    snackFallSpeed = 6;
    snackBounces++;
  } else {
    snackFalling = false;                      // landed: now Pip notices and scoots over
    snprintf(reason, sizeof(reason), "A snack! For me?!");
    targetX = constrain(snackX + (snackX > pipX ? -14 : 14), 16, 184);
    exploreHops = 0;
    animMode = AN_WALK;
  }
  return true;
}

void dropSnack() {
  if (snackX >= 0) return;  // one snack at a time
  do { snackX = randomX(16, 184); } while (abs(snackX - pipX) < 20);
  snackDropY = FLOOR_Y - 5 - 20;   // starts at the top of the room
  snackFallSpeed = 6;
  snackBounces = 0;
  snackFalling = true;
  eatingSnack = true;
  touchedPending = true;  // being fed counts as attention from you
  action = A_EAT;
  snprintf(reason, sizeof(reason), "Something's falling!");
  animMode = AN_REST;     // Pip waits and watches until it lands
  pipJump = 0;
  squash = 100;
  facing = snackX > pipX ? 1 : -1;
  nextFrameAt = millis();
  needRedraw = true;
}

void finishSnack() {
  eatingSnack = false;
  snackX = -1;
  snackCount++;
  pip.food = pip_clamp01(pip.food + 0.2f);
  pip.grumpy *= 0.5f; pip.frustrated *= 0.5f; pip.sulky *= 0.7f;  // a treat helps bad moods
  pip.fun = pip_clamp01(pip.fun + 0.03f);
  saveState();
  snprintf(reason, sizeof(reason), "Yum! Thank you!");
  speak(pip.food > 0.85f ? 'J' : 'H', 8000);
}

// ================================================================ Bloop comes to visit
// Bloop is the pet on the other board (bloop_room in the esp32-s3-touch-lcd-3.5c
// repo). Pip calls out over the radio a few times a second. When Bloop's board
// hears Pip loud and clear, the boards are side by side: Pip hops into Bloop's
// room on Bloop's screen, Bloop answers, and Bloop shows up in Pip's room here.

// The radio message. Must match the copy in bloop_room/visitor.h.
struct __attribute__((packed)) PalMsg {
  uint8_t magic[4];   // "PAL1"
  uint8_t who;        // PAL_PIP or PAL_BLOOP
  uint8_t action;     // what the sender is doing (its own action number)
  uint8_t flags;      // PALF_* bits about the sender
  uint8_t hosting;    // Bloop: 1 while Pip is in Bloop's room
};
enum : uint8_t { PAL_PIP = 1, PAL_BLOOP = 2 };
enum : uint8_t { PALF_SAD = 1, PALF_ASLEEP = 2 };

bool bloopHere = false;                 // the boards are together right now
volatile uint32_t bloopHeardMs = 0;     // written by the radio, read by loop()
volatile bool bloopHosting = false;
volatile uint8_t bloopFlags = 0;
volatile uint8_t palAction = 0, palFlags = 0;   // what Pip tells Bloop about itself
uint8_t bloopFlagsDrawn = 0;
bool palReady = false;
Ticker palTicker;
const uint8_t PAL_EVERYONE[6] = {0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF};

// Bloop in black and white: a dark blob with pointy ears, feet and a pale belly.
// It stands next to Pip.
void drawBloopGuest() {
  const int r = 15;
  int cx = constrain(pipX > 100 ? pipX - 46 : pipX + 46, 22, 178);
  int cy = FLOOR_Y - 3 - r, top = cy - r;
  int look = pipX > cx ? 2 : -2;
  bool asleep = bloopFlags & PALF_ASLEEP, sad = bloopFlags & PALF_SAD;

  display.fillCircle(cx - 7, FLOOR_Y - 4, 4, GxEPD_BLACK);   // feet
  display.fillCircle(cx + 7, FLOOR_Y - 4, 4, GxEPD_BLACK);
  int tip = sad ? top + 4 : top - 6, out = sad ? 19 : 12;    // ears droop when it's sad
  display.fillTriangle(cx - 12, cy - 6, cx - 3, top + 2, cx - out, tip, GxEPD_BLACK);
  display.fillTriangle(cx + 12, cy - 6, cx + 3, top + 2, cx + out, tip, GxEPD_BLACK);
  display.fillCircle(cx, cy, r, GxEPD_BLACK);                // body
  display.fillCircle(cx, cy + 6, 7, GxEPD_WHITE);            // belly
  for (int s = -1; s <= 1; s += 2) {                         // eyes
    int ex = cx + s * 6;
    if (asleep) { display.drawLine(ex - 3, cy - 4, ex + 3, cy - 4, GxEPD_WHITE); continue; }
    display.fillCircle(ex, cy - 4, 4, GxEPD_WHITE);
    display.fillCircle(ex + look, cy - 4, 2, GxEPD_BLACK);
  }
  if (!asleep) drawArc(cx, cy + (sad ? 6 : 3), 3, sad ? -2 : 2, 1);   // mouth
  else { printAt("z", cx + r + 1, top + 2, 1); printAt("Z", cx + r + 6, top - 8, 1); }
  printAt("Bloop", constrain(cx - 15, 1, 169), top - (asleep ? 26 : 18), 1);
}

void drawScreen() {
  redrawCount++;
  bool full = redrawCount == 1 || (fullRefreshDue && animMode == AN_REST);
  if (full) { display.setFullWindow(); partialsSinceFull = 0; fullRefreshDue = false; }
  else {
    display.setPartialWindow(0, 0, display.width(), display.height());
    if (++partialsSinceFull >= FULL_REFRESH_AFTER) fullRefreshDue = true;
  }

  bool sad = min(min(pip.food, pip.energy), min(pip.fun, min(pip.comfort, pip.social))) < 0.25f;
  char header[40], right[24], label[24], line1[34];
  String words = personalityWords();
  snprintf(header, sizeof(header), "%s: %s", PET_NAME, words.c_str());
  int hr = (int)senses.hour, mn = (int)((senses.hour - hr) * 60);
  if (clockSet) snprintf(right, sizeof(right), "%.0fC %02d:%02d", senses.tempC, hr, mn);
  else snprintf(right, sizeof(right), "%.0fC", senses.tempC);
  if (animMode == AN_WALK) snprintf(label, sizeof(label), "%s", "WALKING");
  else snprintf(label, sizeof(label), "%s", PIP_ACTION_NAMES[action]);
  for (char *p = label; *p; p++) *p = (*p == '_') ? ' ' : toupper(*p);
  snprintf(line1, sizeof(line1), "%.32s", reason);

  display.firstPage();
  do {
    display.fillScreen(GxEPD_WHITE);
    printAt(header, 2, 2, 1);
    printAt(right, 198 - (int)strlen(right) * 6, 2, 1);
    display.drawLine(0, 12, 199, 12, GxEPD_BLACK);
    drawRoom();
    drawSnack();
    if (bloopHere) drawBloopGuest();
    drawPip(action, sad);
    drawSpeech();
    printCentered(label, 111, 2);
    printCentered(line1, 129, 1);
    drawBar(141, "FOOD", pip.food);
    drawBar(151, "ENERGY", pip.energy);
    drawBar(161, "FUN", pip.fun);
    drawBar(171, "COMFY", pip.comfort);
    drawBar(181, "LOVE", pip.social);
  } while (display.nextPage());
  display.hibernate();
}

int randomX(int lo, int hi) { return lo + (int)(esp_random() % (uint32_t)(hi - lo + 1)); }

int targetFor(int a) {
  switch (a) {
    case A_NAP: case A_WARM_UP: return BED_X;
    case A_EAT: return BOWL_X - 26;
    case A_HIDE: return BOX_X;
    case A_COOL_DOWN: return 70;
    case A_SING: case A_CALL: return 100;
    case A_PLAY: return randomX(60, 130);
    case A_EXPLORE: return randomX(20, 170);
    case A_DANCE: return randomX(60, 140);
    case A_WINDOW: return 101;  // right under the window
    default: return pipX;
  }
}

void setKeys(const Key *k, int n) { keys = k; keyLen = n; performStep = 0; }

void beginPerform() {
  animMode = AN_PERFORM;
  setKeys(nullptr, 0);
  if (action == A_PLAY) setKeys(K_PLAY, sizeof(K_PLAY) / sizeof(Key));
  else if (action == A_CALL) setKeys(K_CALL, sizeof(K_CALL) / sizeof(Key));
  else if (action == A_SING) setKeys(K_SING, sizeof(K_SING) / sizeof(Key));
  else if (action == A_EAT) { facing = (snackX >= 0) ? (snackX > pipX ? 1 : -1) : 1; setKeys(K_EAT, sizeof(K_EAT) / sizeof(Key)); }
  else if (action == A_WARM_UP) setKeys(K_SHIVER, sizeof(K_SHIVER) / sizeof(Key));
  else if (action == A_DANCE) setKeys(K_DANCE, sizeof(K_DANCE) / sizeof(Key));
  else if (action == A_WINDOW) setKeys(K_LOOK, sizeof(K_LOOK) / sizeof(Key));
}

// Called by think(): walk to where this action happens, then do it.
void startAction(int a) {
  if (eatingSnack) return;  // finish the snack first; the brain decides again next time
  exploreHops = (a == A_EXPLORE) ? 2 : 0;
  targetX = targetFor(a);
  if (abs(targetX - pipX) > 4) animMode = AN_WALK;
  else beginPerform();
  nextFrameAt = millis();
}

// A happy little hop (when petted, or just because).
void startHop() {
  animMode = AN_PERFORM;
  setKeys(K_HOP, sizeof(K_HOP) / sizeof(Key));
  nextFrameAt = millis();
}

void restNow() {
  animMode = AN_REST;
  pipJump = 0;
  squash = 100;
  keys = nullptr;
  bool still = action == A_NAP || action == A_HIDE || action == A_WARM_UP;
  nextAmbientAt = millis() + (still ? 60000UL : 8000UL + esp_random() % 12000UL);  // little moves every 8-20 s
  if (fullRefreshDue) needRedraw = true;  // a good moment to clean the screen
}

// One animation frame. Returns true if the screen needs redrawing.
bool animFrame() {
  if (animMode == AN_WALK) {
    // Blobs don't walk, they scoot: stretch forward, then squash down, a little hop each time
    int dx = targetX - pipX;
    facing = dx > 0 ? 1 : -1;
    pipX += facing * min(WALK_STEP, abs(dx));
    legPhase ^= 1;
    squash = legPhase ? 86 : 116;
    pipJump = legPhase ? -3 : 0;
    if (abs(targetX - pipX) <= 1) {
      pipX = targetX;
      if (exploreHops > 0) {  // explorers check out a few spots
        exploreHops--;
        targetX = randomX(20, 170);
      } else {
        squash = 118; pipJump = 0;  // land
        beginPerform();
      }
    }
    return true;
  }
  if (animMode == AN_PERFORM) {
    if (keys && performStep < keyLen) {
      pipJump = keys[performStep].y;
      squash = keys[performStep].sq;
      performStep++;
      if (action == A_PLAY && pipJump <= -20) facing = -facing;  // turns in the air
      if (action == A_DANCE) facing = (performStep % 2) ? 1 : -1;  // dances side to side
      return true;
    }
    bool settle = squash != 100 || pipJump != 0 || performStep == 0;
    if (eatingSnack) finishSnack();
    restNow();
    return settle;
  }
  return false;
}

// Little things Pip does on its own between thoughts.
void ambient() {
  if (millis() < nextAmbientAt) return;
  bool still = action == A_NAP || action == A_HIDE || action == A_WARM_UP;
  if (still) { nextAmbientAt = millis() + 60000UL; return; }
  uint32_t r = esp_random() % 4;
  if (r == 0) {
    startHop();
  } else if (r == 1) {
    facing = -facing;
    needRedraw = true;
    restNow();
  } else if (r == 2) {  // a little wobble
    animMode = AN_PERFORM;
    setKeys(K_SING, sizeof(K_SING) / sizeof(Key));
    nextFrameAt = millis();
  } else {
    targetX = constrain(pipX + (int)(esp_random() % 60) - 30, 16, 184);
    exploreHops = 0;
    animMode = AN_WALK;
    nextFrameAt = millis();
  }
}

// Run from loop(): advance the animation when it's time.
void animTick() {
  if (snackFalling) {
    if (millis() < nextFrameAt) return;
    if (snackFallFrame()) needRedraw = true;
    nextFrameAt = millis();
    return;
  }
  if (animMode == AN_REST) { ambient(); return; }
  if (millis() < nextFrameAt) return;
  if (animFrame()) needRedraw = true;
  nextFrameAt = millis();  // next frame as soon as the screen is ready (about 3 per second)
}

// ================================================================ talking
// Every few minutes Pip says something that fits the moment: how it feels, the
// time of day, the temperature, whether you just petted it, and its personality.
// The words are GENERATED on the board by a tiny language model (pip_voice.h),
// so Pip comes up with new sentences rather than repeating a list.

char speech[40] = "";  // up to 31 characters fit in the bubble
unsigned long speechUntil = 0, nextSpeechAt = 30000;

static const char *L_SLEEP[]   = {"zzz... berries...", "mmm... five more mins", "*snore*", "zzz... boing..."};
static const char *L_HUNGRY[]  = {"Is it snack o'clock?", "My tummy says hi", "Food? Food!"};
static const char *L_TIRED[]   = {"So... sleepy...", "Yawwwn", "Need a nap"};
static const char *L_LONELY[]  = {"Where did you go?", "I miss you!", "Anyone there?"};
static const char *L_BORED[]   = {"I'm sooo bored", "Play with me?", "Nothing to do..."};
static const char *L_COLD[]    = {"Brr! Chilly!", "Is the heater on?", "Cold toes!"};
static const char *L_HOT[]     = {"It's toasty in here", "Phew, so hot!", "I'm melting!"};
static const char *L_NIGHT[]   = {"The moon is pretty", "Shh, it's late", "Night night"};
static const char *L_MORNING[] = {"Good morning!", "Rise and wiggle!", "New day!"};
static const char *L_PETTED[]  = {"Hehe, that tickles!", "I like you!", "More pats!", "Again! Again!"};
static const char *L_CURIOUS[] = {"What's in the box?", "Ooh, what's that?", "I wonder..."};
static const char *L_PLAYFUL[] = {"Bet I jump higher!", "Boing boing!", "Catch me!"};
static const char *L_LAZY[]    = {"Naps are life", "Too comfy to move", "Five more minutes"};
static const char *L_BRAVE[]   = {"I fear nothing!", "Adventure time!"};
static const char *L_SHY[]     = {"...hi", "Don't look at me", "*hides a bit*"};
static const char *L_CUDDLY[]  = {"You're my favourite!", "Hug?", "Love you lots!"};
static const char *L_HAPPY[]   = {"Blub!", "I'm a happy blob", "Wiggle wiggle", "What a nice day"};
#define LINES(a) a, (int)(sizeof(a) / sizeof(a[0]))

// Fallback phrases, used only if the voice model writes something in the wrong format.
LineSet fallbackFor(char mood) {
  switch (mood) {
    case 'S': return {LINES(L_SLEEP)};   case 'H': return {LINES(L_HUNGRY)};  case 'T': return {LINES(L_TIRED)};
    case 'L': return {LINES(L_LONELY)};  case 'B': return {LINES(L_BORED)};   case 'K': return {LINES(L_COLD)};
    case 'W': return {LINES(L_HOT)};     case 'N': return {LINES(L_NIGHT)};   case 'M': return {LINES(L_MORNING)};
    case 'P': return {LINES(L_PETTED)};  case 'C': return {LINES(L_CURIOUS)}; case 'Y': return {LINES(L_PLAYFUL)};
    case 'Z': return {LINES(L_LAZY)};    case 'R': return {LINES(L_BRAVE)};   case 'X': return {LINES(L_SHY)};
    case 'A': return {LINES(L_CUDDLY)};  default:  return {LINES(L_HAPPY)};
  }
}

float voiceRand01() { return esp_random() / 4294967296.0f; }

// Pip writes a brand-new sentence for this mood with its voice model, one letter at a time.
void speak(char mood, unsigned long ms) {
  // Whatever the model writes is shown, as long as it's a proper sentence:
  // not empty, finished before running off the bubble, and only normal characters
  // (lowercase letters, spaces and ! ? . , ' ~ * < 3), not mood codes.
  const int MAX_CHARS = 31;  // the widest bubble that fits on the 200-pixel screen
  char text[MAX_CHARS + 2];
  bool ok = false;
  for (int attempt = 0; attempt < 5 && !ok; attempt++) {
    int n = pv_generate(mood, text, MAX_CHARS + 1, 0.75f, voiceRand01);
    ok = n >= 1 && n <= MAX_CHARS;
    for (int i = 0; ok && i < n; i++) ok = strchr("abcdefghijklmnopqrstuvwxyz !?.,'~*<3", text[i]) != nullptr;
  }
  if (!ok) {
    LineSet f = fallbackFor(mood);
    snprintf(text, sizeof(text), "%s", f.lines[esp_random() % f.n]);
  } else if (text[0] >= 'a' && text[0] <= 'z') {
    text[0] -= 32;  // capital first letter
  }
  snprintf(speech, sizeof(speech), "%s", text);
  diarySaid(speech);
  speechUntil = millis() + ms;
  needRedraw = true;
  Serial.printf("Pip says (%c%s): \"%s\"\n", mood, ok ? "" : ", fallback", speech);
}

void speakSomething() {
  char moods[12];
  int n = 0;
  bool night = clockSet && (senses.hour >= 22 || senses.hour < 6);
  bool morning = clockSet && senses.hour >= 6 && senses.hour < 10;
  const char FEEL_MOOD[4] = {'G', 'U', 'F', 'Q'};
  int feel = strongestFeeling(0.35f);
  if (feel >= 0 && esp_random() % 10 < 7) { speak(FEEL_MOOD[feel], 15000); return; }
  if (action == A_NAP) { speak('S', 20000); return; }
  if (action == A_DANCE && esp_random() % 3 != 0) { speak('D', 15000); return; }
  if (action == A_WINDOW && esp_random() % 3 != 0) { speak('V', 15000); return; }
  // Things Pip is feeling right now come first...
  if (pip.food < 0.3f) moods[n++] = 'H';
  if (pip.energy < 0.3f) moods[n++] = 'T';
  if (pip.social < 0.3f) moods[n++] = 'L';
  if (pip.fun < 0.3f) moods[n++] = 'B';
  if (haveSensor && senses.tempC < 18) moods[n++] = 'K';
  if (haveSensor && senses.tempC > 27) moods[n++] = 'W';
  if (night) moods[n++] = 'N';
  if (morning) moods[n++] = 'M';
  // ...otherwise its personality talks (or it's just a happy blob)
  if (n == 0 || esp_random() % 3 == 0) {
    if (traits.curious > 0.6f) moods[n++] = 'C';
    if (traits.playful > 0.6f) moods[n++] = 'Y';
    if (traits.lazy > 0.6f) moods[n++] = 'Z';
    if (traits.brave > 0.7f) moods[n++] = 'R';
    if (traits.brave < 0.3f) moods[n++] = 'X';
    if (traits.affectionate > 0.6f) moods[n++] = 'A';
    moods[n++] = 'J';
  }
  speak(moods[esp_random() % n], 20000);
}

void sayPetted() { speak('P', 8000); }

// Run from loop(): start talking now and then, and stop when the bubble's time is up.
void speechTick() {
  if (speech[0] && millis() > speechUntil) { speech[0] = 0; needRedraw = true; }
  if (millis() < nextSpeechAt || animMode != AN_REST || speech[0]) return;
  speakSomething();
  nextSpeechAt = millis() + 90000UL + esp_random() % 150000UL;  // every 1.5-4 minutes
}

// A speech bubble above Pip with a little tail pointing at it.
void drawSpeech() {
  if (!speech[0]) return;
  bool onBed = pipX < 52 && (action == A_NAP || action == A_WARM_UP) && animMode != AN_WALK;
  int ry = BLOB_RY * 100 / squash;
  int top = (onBed ? 97 : FLOOR_Y) + pipJump - 2 * ry - 5;
  int w = strlen(speech) * 6 + 10, h = 13;
  int x = constrain(pipX - w / 2, 1, 199 - w);
  int y = max(14, top - h - 7);
  int tx = constrain(pipX, x + 6, x + w - 6);
  display.fillRoundRect(x, y, w, h, 4, GxEPD_WHITE);
  display.drawRoundRect(x, y, w, h, 4, GxEPD_BLACK);
  display.fillTriangle(tx - 3, y + h - 1, tx + 3, y + h - 1, tx, y + h + 5, GxEPD_WHITE);
  display.drawLine(tx - 3, y + h - 1, tx, y + h + 5, GxEPD_BLACK);
  display.drawLine(tx + 3, y + h - 1, tx, y + h + 5, GxEPD_BLACK);
  printAt(speech, x + 5, y + 3, 1);
}

